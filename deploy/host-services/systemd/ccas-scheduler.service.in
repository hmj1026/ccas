[Unit]
Description=CCAS APScheduler (host-managed)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__CCAS_BACKEND__
ExecStart=__CCAS_RUNNER__ scheduler __UV_BIN__
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
